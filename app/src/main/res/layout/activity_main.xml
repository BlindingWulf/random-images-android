<?xml version="1.0" encoding="utf-8"?>
<!--
  Portrait viewer. The control panel deliberately takes about two fifths of the
  screen: the search field, filters and timer are the controls in use most, and
  crowding them against the navigation bar made them hard to hit one-handed.
  Tapping the image hides the toolbar and this panel for a full-screen view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.RandomImages.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:title="@string/app_name" />

    <com.blindingwulf.randomimages.ZoomableImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:background="@color/viewer_bg"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/caption_bg"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/caption_fg"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <!-- saveEnabled: id/panel is shared with the landscape variant (also a
         ScrollView), and SavedState must never be restored across a rotation
         into a different view class — the flag makes that impossible by
         construction. The ScrollView + fillViewport pair is the hotfix for
         tall fonts and stubby aspect ratios: when the controls fit, the
         weighted spacers still spread them over the panel; when they do not
         (large display-size settings, short screens), the panel scrolls
         instead of clipping the interval row off the bottom of the screen. -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:background="?attr/colorSurfaceContainer"
        android:fillViewport="true"
        android:saveEnabled="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_hint"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/queryInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="56dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- One column for both buttons, so the pop-out control sits directly
                 under Start/Pause at the same width instead of reading as an
                 unrelated full-width row. The floating window used to arrive by
                 itself whenever the slideshow started; it is now a deliberate act
                 with its own control. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minWidth="160dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/startButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="104dp"
                    android:text="@string/start" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/popoutButton"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/popout_show" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- A plain (non-exclusive) ChipGroup used purely as the flow row for
             the rating group and the content filter, so the filter always
             sits immediately after the last rating chip. It used to be a
             sibling beside a weighted column: whenever that column wrapped
             (large display size, narrow or short screens) the chip hung
             alone beside dead space. Now the row either stays on one line
             or the filter wraps with it — tight at every aspect ratio.
             The nested ratingChip group is not Checkable, so the outer group
             ignores it and single-selection keeps working; the filter chip
             is a direct child with its own listener. Checked = blocked terms
             are excluded from every request; the term list itself is edited
             from the overflow menu. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filterFlow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/ratingGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSfw"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/rating_sfw"
                    app:chipMinHeight="46dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMature"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rating_mature"
                    app:chipMinHeight="46dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExplicit"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rating_explicit"
                    app:chipMinHeight="46dp" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBlacklist"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checked="true"
                android:contentDescription="@string/blacklist_toggle_desc"
                android:text="@string/blacklist_chip"
                app:chipIcon="@drawable/ic_filter_off"
                app:chipIconTint="?attr/colorOnSurfaceVariant"
                app:chipMinHeight="46dp" />
        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Source row spans the full panel width and wraps on its own; it has
             no fixed-height neighbour to float beside. -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/sourceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBoth"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/source_random"
                app:chipMinHeight="46dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipE621"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_e621"
                app:chipMinHeight="46dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFa"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source_fa"
                app:chipMinHeight="46dp" />
        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/previousButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/previous"
                app:icon="@drawable/ic_previous"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nextButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/next"
                app:icon="@drawable/ic_next"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <!-- Fixed width: the text runs from "Every 1 s" to "Every 300 s", and
                 a wrap_content label changes the weighted slider's left edge
                 mid-drag, which the finger reads as the thumb jittering. -->
            <TextView
                android:id="@+id/intervalLabel"
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/intervalSlider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="15"
                android:valueFrom="1"
                android:valueTo="300" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
