# Copy to keystore.properties in this folder and fill in. The file is read by
# app/build.gradle.kts and is gitignored; without it, assembleRelease still
# works but produces an unsigned APK (and adb install will refuse it).
#
# Paths are resolved relative to the repository root, so a keystore kept
# outside the checkout is fine — that is what this project does.
#
# Create a key with:
#   keytool -genkeypair -v -keystore riv-release.jks -alias riv-release \
#           -keyalg RSA -keysize 2048 -sigalg SHA256withRSA -validity 10000 \
#           -dname "CN=..., OU=..., O=..., C=US"
storeFile=../riv-android-signing/riv-release.jks
storePassword=change-me
keyAlias=riv-release
keyPassword=change-me
